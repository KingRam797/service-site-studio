# Optional: POST receives the validated inquiry JSON.
INQUIRY_WEBHOOK_URL=

# Direct delivery of build review requests to the business email in
# config/site.config.ts. Set RESEND_API_KEY and inquiries are emailed there.
#
#   1. Sign up at resend.com using that same business address.
#   2. Create an API key and set it here (and in the Vercel project, for all
#      three environments).
#
# Without INQUIRY_FROM_EMAIL the sender falls back to Resend's shared test
# address, which needs no domain of your own but only delivers to the address
# the Resend account was registered with. That is enough to email the owner.
# To send from your own domain, verify it in Resend and set INQUIRY_FROM_EMAIL
# to an address on it, e.g. "push2Start <hello@yourdomain.com>".
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=

# Optional canonical site URL.
NEXT_PUBLIC_SITE_URL=

# Client authentication (Clerk via Vercel Marketplace).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Client inquiries, projects, provider status, and milestone state (Neon Postgres).
DATABASE_URL=

# Authenticated milestone checkout and signed payment confirmation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
