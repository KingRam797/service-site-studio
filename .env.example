# Optional: POST receives the validated inquiry JSON.
INQUIRY_WEBHOOK_URL=

# Direct delivery of build review requests to the business email in
# config/site.config.ts. Set RESEND_API_KEY and inquiries are emailed there.
#
#   1. Create a Resend API key and set it here (and in the Vercel project, for
#      all three environments).
#   2. Keep push2startstudio.com "Verified" in Resend; its DNS records are in
#      docs/INQUIRY_EMAIL.md. Until then Resend refuses every send.
#
# Inquiries are sent from "push2Start <inquiries@push2startstudio.com>".
# INQUIRY_FROM_EMAIL overrides that. "push2Start <onboarding@resend.dev>" is
# Resend's shared test sender: it needs no domain but only delivers to the
# address the Resend account was registered with.
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=

# Optional: send inquiry notifications somewhere other than the public contact
# address in config/site.config.ts. Leave unset to deliver to that address.
# Only needed with the shared test sender, which delivers solely to the Resend
# account's registration address.
INQUIRY_TO_EMAIL=

# Optional canonical site URL.
NEXT_PUBLIC_SITE_URL=

# Client authentication (Clerk via Vercel Marketplace).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Client inquiries, projects, provider status, and milestone state (Neon Postgres).
DATABASE_URL=

# Authenticated milestone checkout and signed payment confirmation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
